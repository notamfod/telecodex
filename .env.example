TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# The forum supergroup TeleCodex works in. Needed by the pinned status board,
# /projects links, and topic sync.
TELEGRAM_FORUM_CHAT_ID=

# Set this to ALSO open a forum topic for every Codex thread that does not have
# one yet, refreshed on this interval. Leave it empty to keep that sweep off:
# on a machine with a long Codex history it creates one topic per old thread.
TOPIC_SYNC_INTERVAL_SECONDS=
TELEGRAM_MAX_ACTIVE_TOPICS=4
TELEGRAM_PROGRESS_HEARTBEAT_SECONDS=120

# Optional pinned Jira panel in one Telegram forum topic.
JIRA_PANEL_CHAT_ID=
JIRA_PANEL_TOPIC_ID=
JIRA_CLIENT_PATH=jira-client

# Optional Jira comment posting. All three values are required together.
JIRA_COMMENT_SERVER=
JIRA_COMMENT_LOGIN=
JIRA_COMMENT_TOKEN=

# Morning inbox digest target. Leave the topic empty to send to General.
INBOX_DIGEST_CHAT_ID=
INBOX_DIGEST_TOPIC_ID=

# Persistent token accounting. The weekly limit only adds warnings.
TELEGRAM_WEEKLY_TOKEN_LIMIT=

# Optional Sentry-to-inbox bridge. The map is keyed by Sentry project slug.
SENTRY_URL=
SENTRY_TOKEN=
SENTRY_ORG=
# Example: {"project":{"inboxContextKey":"-1001234567890:123","workspace":"/path/to/project"}}
SENTRY_BRIDGE_MAP_JSON=
SENTRY_BRIDGE_INTERVAL_SECONDS=900
SENTRY_BRIDGE_LIMIT=5
CODEX_API_KEY=
CODEX_MODEL=
# Optional model/provider choices shown by /new and /model. No API keys here.
CODEX_MODEL_CHOICES_JSON=[{"id":"openai-default","label":"OpenAI GPT-5.6 Sol","provider":"openai","model":"gpt-5.6-sol","supportsImages":true},{"id":"glm-53","label":"Z.AI GLM-5.3","provider":"zai","model":"glm-5.3","supportsImages":false,"webSearch":"disabled"}]
CODEX_DEFAULT_MODEL_CHOICE=openai-default
MAX_FILE_SIZE=20971520
CODEX_SANDBOX_MODE=workspace-write
CODEX_APPROVAL_POLICY=never
# Optional extra profiles for /launch_profiles, e.g. [{"id":"review","label":"Review","sandboxMode":"workspace-write","approvalPolicy":"on-request"}]
CODEX_LAUNCH_PROFILES_JSON=
CODEX_DEFAULT_LAUNCH_PROFILE=default
# Set to true to expose the built-in Full Access profile and allow extra danger-full-access profiles.
ENABLE_UNSAFE_LAUNCH_PROFILES=false
TOOL_VERBOSITY=summary
SHOW_TURN_TOKEN_USAGE=false
ENABLE_TELEGRAM_LOGIN=false
ENABLE_TELEGRAM_REACTIONS=false
OPENAI_API_KEY=
GITLAB_URL=
GITLAB_TOKEN=
GITLAB_GROUP_ID=
GITLAB_WORKSPACE_ROOT=

# Scheduled review recipes: copy recipes/recipes.example.json to recipes/recipes.json
RECIPES_CONFIG=
# Run as "<command> <threadId>" after a thread is reloaded, for sync tools that
# guard against continuing a thread that changed elsewhere.
# How often the pinned status board in the forum's closed Dashboard topic is refreshed.
# It only edits the message when the work actually changed, so an idle board is free.
STATUS_BOARD_INTERVAL_SECONDS=30

THREAD_REOPEN_COMMAND=
